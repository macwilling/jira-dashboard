# Jira Cloud credentials
JIRA_URL=https://yourcompany.atlassian.net
NEXT_PUBLIC_JIRA_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=your-api-token

# Cloudflare credentials (for KV config storage + D1 release store)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_KV_NAMESPACE_ID=your-cloudflare-kv-namespace-id
CLOUDFLARE_D1_DATABASE_ID=your-cloudflare-d1-database-id

# Shared secret for incoming Jira webhooks (optional in dev; required in prod)
JIRA_WEBHOOK_SECRET=generate-a-random-string

# Site password (optional — if not set, app is publicly accessible)
SITE_PASSWORD=

# Google OAuth (for Google Tasks + Calendar integration in release checklists)
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
# Enable: Tasks API, Google Calendar API
# Create OAuth 2.0 Client ID (Web Application)
# Add authorized redirect URI: https://<your-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
