# Jira Cloud credentials
JIRA_URL=https://yourcompany.atlassian.net
NEXT_PUBLIC_JIRA_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=your-api-token

# Cloudflare credentials (for KV config storage + D1 release store)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_KV_NAMESPACE_ID=your-cloudflare-kv-namespace-id
CLOUDFLARE_D1_DATABASE_ID=your-cloudflare-d1-database-id

# Shared secret for incoming Jira webhooks (optional in dev; required in prod)
JIRA_WEBHOOK_SECRET=generate-a-random-string

# Google OAuth (for Google Tasks + Calendar integration in release checklists)
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
# Enable: Tasks API, Google Calendar API
# Create OAuth 2.0 Client ID (Web Application)
# Add authorized redirect URI: https://<your-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack bot token (for release notification delivery).
# Create an app at https://api.slack.com/apps, install to workspace with scopes:
#   chat:write, channels:read, users:read
# Paste the `xoxb-…` Bot User OAuth Token here. Server-only — never exposed to
# the browser. Rotate by regenerating in the Slack app's OAuth & Permissions
# page and updating this value (or the Vercel env var in production).
SLACK_BOT_TOKEN=

# Slack signing secret (required only if using the release approval gate).
# Found at: Slack app → Basic Information → App Credentials → Signing Secret.
# Verifies that incoming interactive-component POSTs really came from Slack.
# Also requires: Slack app → Interactivity & Shortcuts enabled, with Request URL
#   <NEXT_PUBLIC_APP_URL>/api/webhooks/slack/interactive
SLACK_SIGNING_SECRET=

# AWS S3 (for the /files page — public-read bucket)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# Freshdesk (for support ticket intake via Slack)
# API key found at: Freshdesk → Profile Settings → API Key
# Domain is the subdomain of your Freshdesk instance (e.g. "sysdyne" for sysdyne.freshdesk.com)
FRESHDESK_DOMAIN=yourcompany
FRESHDESK_API_KEY=

# Read AI meeting webhook → Claude routine bridge (/api/webhooks/readai)
# Signing key: shown when creating the webhook in Read AI (Integrations →
# Webhooks) — base64 string used to verify the X-Read-Signature header.
# Preferred. If unset, the receiver falls back to a ?secret= query param
# (append it to the webhook URL, since Read AI allows no custom headers).
READAI_WEBHOOK_SIGNING_KEY=
READAI_WEBHOOK_SECRET=
# The claude.ai routine that writes meeting notes to the Obsidian vault.
# ID (trig_…) and API token (sk-ant-oat01-…) come from the routine's API
# trigger configuration on claude.ai.
CLAUDE_ROUTINE_ID=
CLAUDE_ROUTINE_TOKEN=

# GitHub (for /github PR stats page)
# Create a classic PAT at https://github.com/settings/tokens — needs repo scope (read-only is fine)
GITHUB_TOKEN=

# Public base URL for this app (used in Slack message "View in app" buttons
# and to derive the interactive Request URL). Set to your production origin
# in prod; in local dev, use your tunneled URL if testing Slack interactivity.
NEXT_PUBLIC_APP_URL=https://your-app.example.com
